<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>structure</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Syntax-only parsing; no compilation, so no reference assemblies needed.
         docgen pins 2.9.0 (2018) for the same technique; the extractor is a new
         tool rather than an extension of docgen because docgen's input side is
         slated for retirement (vNext W4) and its Roslyn is 8 years old. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>

</Project>
