<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- RhinoCommon as rhino3dm builds it: the spec, executed. Pure members
         (value types) need no native library; native-backed ones need
         librhino3dm_native next to the oracle binary. -->
    <ProjectReference Include="../../../src/dotnet/Rhino3dm.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
