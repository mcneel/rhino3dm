{
  "about": "Parity cases: each is evaluated by the .NET oracle (RhinoCommon via rhino3dm's managed build) to produce golden/<file>.json, and by every binding runner, which must match it. Chosen to exercise behavior and edge cases, not to enumerate members. Values: numbers, booleans, \"NaN\"/\"Inf\"/\"-Inf\", {\"Point3d\": [x,y,z]}, {\"Vector3d\": [...]}, {\"Interval\": [t0,t1]}. A case has a type, an optional self (constructor args, or {\"static\": name}), and one of: member (+ args; no args = property), op (+ operands), index.",
  "cases": [
    {"id": "point3d.distanceto",            "type": "Point3d",  "self": [1, 2, 3], "member": "DistanceTo", "args": [{"Point3d": [4, 6, 3]}]},
    {"id": "point3d.distanceto.unset_self", "type": "Point3d",  "self": {"static": "Unset"}, "member": "DistanceTo", "args": [{"Point3d": [4, 6, 3]}], "note": "RhinoCommon returns 0 for invalid points; opennurbs does not"},
    {"id": "point3d.distanceto.unset_arg",  "type": "Point3d",  "self": [1, 2, 3], "member": "DistanceTo", "args": [{"static": "Point3d.Unset"}]},
    {"id": "point3d.distanceto.nan",        "type": "Point3d",  "self": ["NaN", 0, 0], "member": "DistanceTo", "args": [{"Point3d": [0, 0, 0]}]},
    {"id": "point3d.distancetosquared",     "type": "Point3d",  "self": [1, 2, 3], "member": "DistanceToSquared", "args": [{"Point3d": [4, 6, 3]}]},
    {"id": "point3d.isvalid.unset",         "type": "Point3d",  "self": {"static": "Unset"}, "member": "IsValid"},
    {"id": "point3d.isvalid.inf",           "type": "Point3d",  "self": ["Inf", 0, 0], "member": "IsValid"},
    {"id": "point3d.maxcoordinate",         "type": "Point3d",  "self": [-7, 2, 3], "member": "MaximumCoordinate"},
    {"id": "point3d.mincoordinate.unset",   "type": "Point3d",  "self": [{"static": "RhinoMath.UnsetValue"}, 2, -3], "member": "MinimumCoordinate", "note": "unset coordinates are skipped"},
    {"id": "point3d.interpolate",           "type": "Point3d",  "self": [0, 0, 0], "member": "Interpolate", "args": [{"Point3d": [0, 0, 0]}, {"Point3d": [10, 20, 30]}, 0.25], "mutates": true},
    {"id": "point3d.epsilonequals",         "type": "Point3d",  "self": [1, 2, 3], "member": "EpsilonEquals", "args": [{"Point3d": [1.0000001, 2, 3]}, 1e-6]},
    {"id": "point3d.compareto",             "type": "Point3d",  "self": [1, 2, 3], "member": "CompareTo", "args": [{"Point3d": [1, 2, 4]}]},
    {"id": "point3d.index",                 "type": "Point3d",  "self": [1, 2, 3], "index": 2},
    {"id": "point3d.index.out_of_range",    "type": "Point3d",  "self": [1, 2, 3], "index": 3},
    {"id": "point3d.op.add_vector",         "type": "Point3d",  "op": "+", "args": [{"Point3d": [1, 2, 3]}, {"Vector3d": [1, 1, 1]}]},
    {"id": "point3d.op.sub_point",          "type": "Point3d",  "op": "-", "args": [{"Point3d": [4, 6, 3]}, {"Point3d": [1, 2, 3]}]},
    {"id": "point3d.op.scale_left",         "type": "Point3d",  "op": "*", "args": [2.5, {"Point3d": [1, 2, 3]}]},
