<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\dotnet\Rhino3dm.csproj" />
  </ItemGroup>

  <!-- Copy the native library next to this sample's exe so P/Invoke can find it:
       `python build.py dotnet` writes it to build/native/win-x64. -->
  <ItemGroup Condition="exists('..\..\build\native\win-x64\librhino3dm_native.dll')">
    <None Include="..\..\build\native\win-x64\librhino3dm_native.dll">
      <Link>librhino3dm_native.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
<!---
  <ItemGroup>
    <PackageReference Include="Rhino3dm" Version="8.0.1" />
  </ItemGroup>
  -->

</Project>
