      "default": "./rhino3dm.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "rhino3dm.js",
    "rhino3dm.min.js",
    "rhino3dm.module.js",
    "rhino3dm.module.min.js",
    "rhino3dm.wasm",
    "rhino3dm.d.ts",
    "wasm64/"
  ],
  "engines": {
