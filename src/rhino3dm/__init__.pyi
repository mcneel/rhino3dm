        Args:
            dimension: The number of dimensions.
                >= 1. This value is usually 3.
            isRational: true to make a rational NURBS.
            order0: The order in U direction.
                >= 2.
            order1: The order in V direction.
                >= 2.
            controlPointCount0: Control point count in U direction.
