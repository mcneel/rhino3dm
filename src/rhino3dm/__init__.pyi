class BezierCurve:
    """Represents a Bezier curve.

    Note: as an exception, the bezier curve is not derived from `Curve`.
    """

    def ChangeDimension(self, desiredDimension: int) -> bool:
        """Change dimension of bezier.

        Returns:
            true if successful. false if desired_dimension < 1
        """

    @property
    def ControlVertexCount(self) -> int:
        """Number of control vertices in this curve"""

    def CurvatureAt(self, t: float) -> Vector3d:
        """Evaluate the curvature vector at a curve parameter.

        No error handling.

        Args:
            t: Evaluation parameter.

        Returns:
            Curvature vector of the curve at the parameter t.
        """

    @property
    def Dimension(self) -> int:
        """Dimension of Bezier"""

    def GetBoundingBox(self, accurate: bool) -> BoundingBox:
        """Bounding box solver. Gets the world axis aligned bounding box for the curve.

        Args:
            accurate: If true, a physically accurate bounding box will be computed. If not, a bounding box estimate will be computed. For some geometry types there is no difference between the estimate and the accurate bounding box. Estimated bounding boxes can be computed much (much) faster than accurate (or "tight") bounding boxes. Estimated bounding boxes are always similar to or larger than accurate bounding boxes.

        Returns:
            The bounding box of the geometry in world coordinates or BoundingBox.Empty if not bounding box could be found.
        """

    def GetControlVertex3d(self, index: int) -> Point3d:
        """Gets the 3D location of a control vertex at the specified index.

        Args:
            index: Control vertex index (0 <= index < ControlVertexCount).

        Returns:
            The 3D location of the control vertex. If the Bezier is rational, the euclidean location is returned. Returns `Point3d.Unset` if the index is out of range or the control vertex cannot be retrieved.

        Raises:
            ArgumentOutOfRangeException: Thrown when index is out of range.
        """

    def GetControlVertex4d(self, index: int) -> Point4d:
        """Gets the homogeneous (4D) value of a control vertex at the specified index.

        Args:
            index: Control vertex index (0 <= index < ControlVertexCount).

        Returns:
            The homogeneous value of the control vertex. If the Bezier is not rational, the weight is 1. Returns `Point4d.Unset` if the index is out of range or the control vertex cannot be retrieved.

        Raises:
            ArgumentOutOfRangeException: Thrown when index is out of range.
        """

    def IncreaseDegree(self, desiredDegree: int) -> bool:
        """Increase degree of bezier

        Returns:
            true if successful. false if desiredDegree < current degree.
        """

    @property
    def IsRational(self) -> bool:
        """Gets a value indicating whether or not the curve is rational. Rational curves have control-points with custom weights."""

    @property
    def IsValid(self) -> bool:
        """Tests an object to see if it is valid."""

    def MakeNonRational(self) -> bool:
        """Make bezier non-rational

        Returns:
            true if successful
        """

    def MakeRational(self) -> bool:
        """Make bezier rational

        Returns:
            true if successful
        """

    def PointAt(self, t: float) -> Point3d:
        """Evaluates point at a curve parameter.

        No error handling.

        Args:
            t: Evaluation parameter.

        Returns:
            Point (location of curve at the parameter t).
        """

    def TangentAt(self, t: float) -> Vector3d:
        """Evaluates the unit tangent vector at a curve parameter.

        No error handling.

        Args:
            t: Evaluation parameter.

        Returns:
            Unit tangent vector of the curve at the parameter t.
        """

    def ToNurbsCurve(self) -> NurbsCurve:
        """Constructs a NURBS curve representation of this curve.

        Returns:
            NURBS representation of the curve on success, null on failure.
        """

    def Split(self, t: float) -> tuple[bool, BezierCurve, BezierCurve]:
        """Divides the Bezier curve at the specified parameter.

        Args:
            t: parameter must satisfy 0 < t < 1

        Returns:
            true on success
        """

    def GetControlVertex2d(self, index: int) -> Point2d:
        """Get location of a control vertex.

        Args:
            index: Control vertex index (0 <= index < ControlVertexCount)

        Returns:
            If the bezier is rational, the euclidean location is returned.

        Raises:
            ArgumentOutOfRangeException: when index is out of range
        """

class PolyCurve(Curve):
    """Represents a curve that is the result of joining several (possibly different) types of curves."""

    def __init__(self) -> None:
        """Initializes a new, empty polycurve."""

    @overload
    def Append(self, arc: Arc) -> bool:
        """Appends and matches the start of the arc to the end of polycurve. This function will fail if the polycurve is closed or if SegmentCount > 0 and the arc is closed.

        Args:
            arc: Arc segment to append.

        Returns:
            true on success, false on failure.
        """

    @overload
    def Append(self, curve: Curve | None) -> bool:
        """Appends and matches the start of the curve to the end of polycurve. This function will fail if the PolyCurve is closed or if SegmentCount > 0 and the new segment is closed.

        Args:
            curve: Segment to append.

        Returns:
            true on success, false on failure.
        """

    @overload
    def Append(self, line: Line) -> bool:
        """Appends and matches the start of the line to the end of polycurve. This function will fail if the polycurve is closed.

        Args:
            line: Line segment to append.

        Returns:
            true on success, false on failure.
        """

    def AppendSegment(self, curve: Curve | None) -> bool:
        """Appends the curve to the polycurve without changing the new segment's geometry. This function will fail if the PolyCurve is closed or if SegmentCount > 0 and the new segment is closed.

        Args:
            curve: Segment to append.

        Returns:
            true on success, false on failure.
        """

    @property
    def HasGap(self) -> bool:
        """This is a quick way to see if the curve has gaps between the sub curve segments."""

    @property
    def IsNested(self) -> bool:
        """Gets a value indicating whether or not a PolyCurve contains nested PolyCurves."""

    def PolyCurveParameter(self, segmentIndex: int, segmentCurveParameter: float) -> float:
        """Converts a segment curve parameter to a polycurve parameter.

        Args:
            segmentIndex: Index of segment.
            segmentCurveParameter: Parameter on segment.

        Returns:
            Polycurve evaluation parameter or UnsetValue if the polycurve curve parameter could not be computed.
        """

    def RemoveNesting(self) -> bool:
        """Explodes nested polycurve segments and reconstructs this curve from the shattered remains. The result will have not have any PolyCurves as segments but it will have identical locus and parameterization.

        Returns:
            true if any nested PolyCurve was found and absorbed, false if no PolyCurve segments could be found.
        """

    @property
    def SegmentCount(self) -> int:
        """Gets the number of segments that make up this Polycurve."""

    def SegmentCurve(self, index: int) -> Curve:
        """Gets the segment curve at the given index.

        Args:
            index: Index of segment to retrieve.

        Returns:
            The segment at the given index or null on failure.
        """

    def SegmentCurveParameter(self, polycurveParameter: float) -> float:
        """Converts a polycurve parameter to a segment curve parameter.

        Args:
            polycurveParameter: Parameter on PolyCurve to convert.

        Returns:
            Segment curve evaluation parameter or UnsetValue if the segment curve parameter could not be computed.
        """

    def SegmentDomain(self, segmentIndex: int) -> Interval:
        """Returns the polycurve sub-domain assigned to a segment curve.

        Args:
            segmentIndex: Index of segment.

        Returns:
            The polycurve sub-domain assigned to a segment curve. Returns Interval.Unset if segment_index < 0 or segment_index >= Count().
        """

    def SegmentIndex(self, polycurveParameter: float) -> int:
        """Finds the segment used for evaluation at polycurve_parameter.

        Args:
            polycurveParameter: Parameter on polycurve for segment lookup.

        Returns:
            Index of the segment used for evaluation at polycurve_parameter. If polycurve_parameter < Domain.Min(), then 0 is returned. If polycurve_parameter > Domain.Max(), then Count()-1 is returned.
        """

    def SegmentIndexes(self, subdomain: Interval) -> tuple[int, int, int]:
        """Finds the segments that overlap the Polycurve sub domain.

        Args:
            subdomain: Domain on this PolyCurve.

        Returns:
            Number of segments that overlap the sub-domain.
        """

    def Explode(self) -> list[Any]:
        """Explodes this PolyCurve into a list of Curve segments. This will not explode nested polycurves. Call `RemoveNesting` first if you need all individual segments.

        Returns:
            An array of polycurve segments.
        """

    def DuplicatePolyCurve(self) -> PolyCurve:
        """Duplicates this polycurve.

        This is the same as `Duplicate`.

        Returns:
            An exact duplicate of this curve.
        """

