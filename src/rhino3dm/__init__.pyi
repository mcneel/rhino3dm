class ArchivableDictionary:
    """Represents a dictionary class that can be attached to objects and can be serialized (saved) at necessity.

    See remarks for layout.

    This is the layout of this object:

    `BEGINCHUNK (TCODE_ANONYMOUS_CHUNK) |- version (int) |- entry count (int) for entry count entries |- BEGINCHUNK (TCODE_ANONYMOUS_CHUNK) |- key (string) |- entry contents |- ENDCHUNK (TCODE_ANONYMOUS_CHUNK) ENDCHUNK (TCODE_ANONYMOUS_CHUNK)`
    """

    @staticmethod
    def EncodeDict(dict: dict[str, Any]) -> dict[str, Any]:
        """A dict of values as an ArchivableDictionary, in `Encode`'s JSON form (rhino3dm only; inverse: `ArchivableDictionary.DecodeDict`).

        Args:
            dict: A dict of strings, numbers, booleans, points, vectors, and other rhino3dm objects.
        """

    @staticmethod
    def DecodeDict(jsonObject: dict[str, Any]) -> dict[str, Any]:
        """The dict an `EncodeDict` result describes (rhino3dm only).

        Args:
            jsonObject: A dict as `EncodeDict` returns it.
        """
