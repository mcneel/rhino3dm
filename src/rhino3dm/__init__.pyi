class ArcCurve(Curve):
    """Represent arcs and circles.

    ArcCurve.IsCircle returns true if the curve is a complete circle.

    Details:

    an ArcCurve is a sub-curve of a circle, with a constant speed parameterization. The parameterization is an affine linear reparameterization of the underlying arc m_arc onto the domain m_t.

    A valid ArcCurve has Radius()>0 and 0<AngleRadians()<=2*PI and a strictly increasing Domain.
    """

    @overload
    def __init__(self) -> None:
        """Initializes a new `ArcCurve` instance.

        Radius is set to 1, position to Origin and Domain to full span (circle).
        """

    @overload
    def __init__(self, arc: _rh.Arc) -> None:
        """Initializes a new `ArcCurve` instance, copying values from another `Arc`.

        Args:
            arc: Another Arc.
        """

    @overload
    def __init__(self, arc: _rh.Arc, t0: float, t1: float) -> None:
        """Initializes a new `ArcCurve` instance, copying values from another `Arc` and specifying the needed parametrization of the arc.

        Arc will not be cut again at these parameterizations.

        Args:
            arc: An original arc.
            t0: A new Domain.T0 value.
            t1: A new Domain.T1 value.
        """

    @overload
    def __init__(self, other: ArcCurve | None) -> None:
        """Initializes a new `ArcCurve` instance, copying values from another `ArcCurve`.

        Args:
            other: Another ArcCurve.
        """

    @overload
    def __init__(self, circle: Circle) -> None:
        """Initializes a new `ArcCurve` instance, copying the shape of a `Circle`.

        Parameterization will be [0;circle.Circumference]

        Args:
            circle: The original circle.
        """

    @overload
    def __init__(self, circle: Circle, t0: float, t1: float) -> None:
        """Initializes a new `ArcCurve` instance, copying values from a `Circle` and specifying the needed parametrization of the arc.

        Circle will not be newly cut at these parameterizations.

        Args:
            circle: A circle.
            t0: A new Domain.T0 value.
            t1: A new Domain.T1 value.
        """

    @property
    def AngleDegrees(self) -> float:
        """Gets the angles of this arc in degrees."""

    @property
    def AngleRadians(self) -> float:
        """Gets the angles of this arc in radians."""

    @property
    def Arc(self) -> _rh.Arc:
        """Gets the arc that is contained within this ArcCurve."""

    @property
    def IsCompleteCircle(self) -> bool:
        """Gets a value indicating whether or not this curve can be represented by a complete circle."""

    @property
    def Radius(self) -> float:
        """Gets the radius of this ArcCurve."""

class NurbsCurve(Curve):
    """Represents a Non Uniform Rational B-Splines (NURBS) curve."""

    @overload
    def __init__(self, other: NurbsCurve | None) -> None:
        """Initializes a NURBS curve by copying its values from another NURBS curve.

        Args:
            other: The other curve. This value can be null.
        """

    @overload
    def __init__(self, degree: int, pointCount: int) -> None:
        """Constructs a new NURBS curve with a specific degree and control point count.

        Args:
            degree: Degree of curve. Must be equal to or larger than 1 and smaller than or equal to 11.
            pointCount: Number of control-points.
        """

    @overload
    def __init__(self, dimension: int, rational: bool, order: int, pointCount: int) -> None:
        """Constructs a new NURBS curve with knot and CV memory allocated.

        Args:
            dimension: >=1.
            rational: true to make a rational NURBS.
            order: (>= 2) The order=degree+1.
            pointCount: (>= order) number of control vertices.
        """

    def ConvertSpanToBezier(self, spanIndex: int) -> BezierCurve:
        """Converts a span of the NURBS curve into a Bezier.

        Args:
            spanIndex: The span index, where (0 <= spanIndex <= Points.Count - Order).

        Returns:
            Bezier curve if successful, null otherwise.
        """

    def GrevilleParameter(self, index: int) -> float:
        """Gets the greville (edit point) parameter that belongs to the control point at the specified index.

        Args:
            index: Index of Greville (Edit) point.
        """

    @property
    def HasBezierSpans(self) -> bool:
        """Returns true if the NURBS curve has Bezier spans (all distinct knots have multiplicity = degree)"""

    def IncreaseDegree(self, desiredDegree: int) -> bool:
        """Increase the degree of this curve.

        Args:
            desiredDegree: The desired degree. Degrees should be number between and including 1 and 11.

        Returns:
            true on success, false on failure.
        """

    @property
    def IsRational(self) -> bool:
        """Gets a value indicating whether or not the curve is rational. Rational curves have control-points with custom weights."""

    def MakePiecewiseBezier(self, setEndWeightsToOne: bool) -> bool:
        """Clamps ends and adds knots so the NURBS curve has Bezier spans (all distinct knots have multiplicity = degree).

        Args:
            setEndWeightsToOne: If true and the first or last weight is not one, then the first and last spans are re-parameterized so that the end weights are one.

        Returns:
            true on success, false on failure.
        """

    @property
    def Order(self) -> int:
        """Gets the order of the curve. Order = Degree + 1."""

    def Reparameterize(self, c: float) -> bool:
        """Use a linear fractional transformation to re-parameterize the NURBS curve. This does not change the curve's domain.

        The CV and knot values are values are changed so that output_nurbs(t) = input_nurbs(lambda(t)).

        Args:
            c: re-parameterization constant (generally speaking, c should be > 0). The control points and knots are adjusted so that output_nurbs(t) = input_nurbs(lambda(t)), where lambda(t) = c*t/( (c-1)*t + 1 ). Note that lambda(0) = 0, lambda(1) = 1, lambda'(t) > 0, lambda'(0) = c and lambda'(1) = 1/c.

        Returns:
            true if successful.
        """

    @staticmethod
    def CreateFromArc(arc: Arc) -> NurbsCurve:
        """Gets a rational degree 2 NURBS curve representation of the arc. Note that the parameterization of NURBS curve does not match arc's transcendental parameterization.

        Returns:
            Curve on success, null on failure.
        """

    @staticmethod
    def CreateFromCircle(circle: Circle) -> NurbsCurve:
        """Gets a rational degree 2 NURBS curve representation of the circle. Note that the parameterization of NURBS curve does not match circle's transcendental parameterization. Use GetRadianFromNurbFormParameter() and GetParameterFromRadian() to convert between the NURBS curve parameter and the transcendental parameter.

        Returns:
            Curve on success, null on failure.
        """

    @property
    def Knots(self) -> NurbsCurveKnotList:
        """Gets access to the knots (or "knot vector") of this NURBS curve."""

    @property
    def Points(self) -> NurbsCurvePointList:
        """Gets access to the control points of this NURBS curve."""

    def Append(self, nurbsCurve: NurbsCurve) -> bool:
        """Appends a NURBS curve to this curve.

        Args:
            nurbsCurve: The NURBS curve to append.
        """

    @staticmethod
    def Create(periodic: bool, degree: int, points: Sequence[Point3d]) -> NurbsCurve:
        """Constructs a 3D NURBS curve from a list of control points.

        Args:
            periodic: If true, create a periodic uniform curve. If false, create a clamped uniform curve.
            degree: (>=1) degree=order-1.
            points: control vertex locations.

        Returns:
            new NURBS curve on success null on error.
        """

    @staticmethod
    def CreateFromEllipse(ellipse: Ellipse) -> NurbsCurve:
        """Gets a rational degree 2 NURBS curve representation of the ellipse.

        Note that the parameterization of the NURBS curve does not match with the transcendental parameterization of the ellipsis.

        Returns:
            A NURBS curve representation of this ellipse or null if no such representation could be made.
        """

    @staticmethod
    def CreateFromLine(line: Line) -> NurbsCurve:
        """Gets a non-rational, degree 1 NURBS curve representation of the line.

        Returns:
            Curve on success, null on failure.
        """

    def GrevilleParameters(self) -> list[float]:
        """Gets all Greville parameters for this curve."""

    def GrevillePoint(self, index: int) -> Point3d:
        """Gets the Greville parameter that belongs to the control point at the specified index.

        Args:
            index: Index of Greville point.
        """

