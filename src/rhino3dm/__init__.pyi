    def SetMesh(self, mesh: Mesh | None, meshType: MeshType) -> bool:
        """Sets a specified type of mesh for this extrusion.

        Args:
            mesh: The mesh.
            meshType: The mesh type.

        Returns:
            True on success.
        """

    def SetOuterProfile(self, outerProfile: Curve, cap: bool) -> bool:
        """Sets the outer profile of the extrusion.

