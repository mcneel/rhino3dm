        """Create an extrusion from a 3d curve, a plane and a height.

        Args:
            curve: A continuous 3d curve.
            plane: A plane. The 3d curve is projected to this plane and the result is passed to `Extrusion.SetOuterProfile`.
            height: If the height > 0, the bottom of the extrusion will be in plane and the top will be height units above the plane. If the height < 0, the top of the extrusion will be in plane and the bottom will be height units below the plane. The plane used is the one that is returned from the curve's TryGetPlane function.
            cap: If the curve is closed and cap is true, then the resulting extrusion is capped.

        Returns:
            If the input is valid, then a new extrusion is returned. Otherwise null is returned
        """

    @overload
    @staticmethod
    def Create(planarCurve: Curve, height: float, cap: bool) -> Extrusion:
        """Creates an extrusion of a 3d curve (which must be planar) and a height.

        Args:
            planarCurve: Planar curve used as profile
            height: If the height > 0, the bottom of the extrusion will be in plane and the top will be height units above the plane. If the height < 0, the top of the extrusion will be in plane and the bottom will be height units below the plane. The plane used is the one that is returned from the curve's TryGetPlane function.
            cap: If the curve is closed and cap is true, then the resulting extrusion is capped.

        Returns:
            If the input is valid, then a new extrusion is returned. Otherwise null is returned
        """

    @staticmethod
    def CreateCylinderExtrusion(cylinder: Cylinder, capBottom: bool, capTop: bool) -> Extrusion:
        """Gets an extrusion form of a cylinder.

        Args:
            cylinder: IsFinite must be true.
            capBottom: If true, the end at cylinder.Height1 will be capped.
            capTop: If true, the end at cylinder.Height2 will be capped.

        Returns:
            Extrusion on success. null on failure.
        """

    @staticmethod
    def CreatePipeExtrusion(cylinder: Cylinder, otherRadius: float, capTop: bool, capBottom: bool) -> Extrusion:
