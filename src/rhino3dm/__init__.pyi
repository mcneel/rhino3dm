            The zero-based index of the first occurrence of item within the entire List, if found; otherwise, -1.
        """

    @overload
    def LastIndexOf(self, item: Point3d) -> int:
        """Searches for the specified object and returns the zero-based index of the last occurrence within the entire List.

        Args:
            item: The object to locate in the List. The value can be a null reference (Nothing in Visual Basic) for reference types.

        Returns:
            The zero-based index of the last occurrence of item within the entire the List, if found; otherwise, -1.
        """

    @overload
    def LastIndexOf(self, item: Point3d, index: int) -> int:
        """Searches for the specified object and returns the zero-based index of the last occurrence within the range of elements in the List that extends from the first element to the specified index.

        Args:
            item: The object to locate in the List. The value can be a null reference (Nothing in Visual Basic) for reference types.
            index: The zero-based starting index of the backward search.

        Returns:
            The zero-based index of the last occurrence of item within the entire the List, if found; otherwise, -1.
        """

    @overload
    def LastIndexOf(self, item: Point3d, index: int, count: int) -> int:
        """Searches for the specified object and returns the zero-based index of the last occurrence within the range of elements in the List that contains the specified number of elements and ends at the specified index.

        Args:
            item: The object to locate in the List. The value can be a null reference (Nothing in Visual Basic) for reference types.
            index: The zero-based starting index of the backward search.
            count: The number of elements in the section to search.

        Returns:
            The zero-based index of the last occurrence of item within the entire the List, if found; otherwise, -1.
        """

    def BinarySearch(self, item: Point3d) -> int:
        """Searches the entire sorted List for an element using the default comparer and returns the zero-based index of the element.

        Args:
            item: The object to locate. The value can be a null reference (Nothing in Visual Basic) for reference types.

        Returns:
            The zero-based index of item in the sorted List, if item is found; otherwise, a negative number that is the bitwise complement of the index of the next element that is larger than item or, if there is no larger element, the bitwise complement of Count.
        """

    def Contains(self, item: Point3d) -> bool:
        """Determines whether an element is in the List.

        Args:
            item: The object to locate in the List. The value can be a null reference (Nothing in Visual Basic) for reference types.

        Returns:
            true if item is found in the List; otherwise, false.
        """

    def Sort(self) -> None:
        """Sorts the elements in the entire List using the default comparer."""

    @overload
    def Reverse(self) -> None:
        """Reverses the order of the elements in the entire List."""

    @overload
    def Reverse(self, index: int, count: int) -> None:
        """Reverses the order of the elements in the specified range.

        Args:
            index: The zero-based starting index of the range to reverse.
            count: The number of elements in the range to reverse.
        """

class Polyline(Point3dList):
    """Represents an ordered set of points connected by linear segments.

    Polylines are closed if start and end points coincide.
    """

    @overload
    def __init__(self) -> None:
        """Initializes a new empty polyline."""

    @overload
    def __init__(self, initialCapacity: int) -> None:
        """Initializes a new empty polyline with an initial capacity.

        Args:
            initialCapacity: Number of vertices this polyline can contain without resizing.
        """

    @overload
    def __init__(self, collection: Sequence[Point3d]) -> None:
        """Initializes a new polyline from a collection of points.

        Args:
            collection: Points to copy into the local vertex array.
        """

    @property
    def IsValid(self) -> bool:
        """Gets a value that indicates whether this polyline is valid.

        Valid polylines have at least one segment, no Invalid points and no zero length segments.

        Closed polylines with only two segments are also not considered valid.
        """

    @property
    def SegmentCount(self) -> int:
        """Gets the number of segments for this polyline."""

    @property
    def IsClosed(self) -> bool:
        """Test a polyline to see if it is closed."""

    def IsClosedWithinTolerance(self, tolerance: float) -> bool:
        """Test a polyline to see if it is closed.

        Args:
            tolerance: The tolerance.

        Returns:
            Returns true if polyline has 4 or more points, the distance between the start and end points is <= tolerance, and there is a point in the polyline whose distance from the start and end points is > tolerance.
        """

    def IsConvexLoop(self, strictlyConvex: bool) -> bool:
        """Determines if a polyline is convex.

        Args:
            strictlyConvex: If false, collinear segments are considered convex.

        Returns:
            True if the polyline is a closed, convex loop.
        """

    @property
    def Length(self) -> float:
        """Gets the total length of the polyline."""

    def SegmentAt(self, index: int) -> Line:
        """Gets the line segment at the given index.

        Args:
            index: Index of segment to retrieve.

        Returns:
            Line segment at index or Line.Unset on failure.
        """

    def PointAt(self, t: float) -> Point3d:
        """Gets the point on the polyline at the given parameter. The integer part of the parameter indicates the index of the segment.

        Args:
            t: Polyline parameter.

        Returns:
            The point on the polyline at t.
        """

    def TangentAt(self, t: float) -> Vector3d:
        """Gets the unit tangent vector along the polyline at the given parameter. The integer part of the parameter indicates the index of the segment.

        Args:
            t: Polyline parameter.

        Returns:
            The tangent along the polyline at t.
        """

    def Trim(self, domain: Interval) -> Polyline:
        """Constructs a polyline out of a parameter sub-domain in this curve.

        Args:
            domain: The sub-domain of the polyline. The integer part of the domain parameters indicate the index of the segment.

        Returns:
            The polyline as defined by the sub-domain, or null on failure.
        """

    def ClosestPoint(self, testPoint: Point3d) -> Point3d:
        """Gets the point on the polyline which is closest to a test-point.

        Args:
            testPoint: Point to approximate.

        Returns:
            The point on the polyline closest to testPoint.
        """

    def ClosestParameter(self, testPoint: Point3d) -> float:
        """Gets the parameter along the polyline which is closest to a test-point.

        Args:
            testPoint: Point to approximate.

        Returns:
            The parameter along the polyline closest to testPoint.
        """

    def GetSegments(self) -> list[Line] | None:
        """Constructs an array of line segments that make up the entire polyline.

        Returns:
            An array of line segments or null if the polyline contains fewer than 2 points.
        """

    def ToNurbsCurve(self) -> NurbsCurve:
        """Constructs a nurbs curve representation of this polyline.

        Returns:
            A Nurbs curve shaped like this polyline or null on failure.
        """

    def ToPolylineCurve(self) -> PolylineCurve:
        """Constructs a polyline curve representation of this polyline.

        Returns:
            A curve shaped like this polyline or null on failure.
        """

    def DeleteShortSegments(self, tolerance: float) -> int:
        """Removes all points that are closer than tolerance to the previous point.

        Start and end points are left intact.

        Args:
            tolerance: Vertices closer together than tolerance will be removed.

        Returns:
            Number of points (and segments) removed.
        """

    def CollapseShortSegments(self, tolerance: float) -> int:
        """Collapses all segments until none are shorter than tolerance. This function is significantly slower than DeleteShortSegments, since it recursively operates on the shortest segment. When a segment is collapsed the end-points are placed in the center of the segment.

        Args:
            tolerance: Tolerance to use during collapsing.

        Returns:
            The number of segments that were collapsed.
        """

    def ReduceSegments(self, tolerance: float) -> int:
        """Constructs a reduction of this polyline by recursively removing the least significant segments.

        Args:
            tolerance: Tolerance for reduction. Whenever a vertex of the polyline is more significant than tolerance, it will be included in the reduction.

        Returns:
            The number of vertices that disappeared due to reduction.
        """

    def Smooth(self, amount: float) -> bool:
        """Smoothen the polyline segments by averaging adjacent vertices. Smoothing requires a polyline with exclusively valid vertices.

        Args:
            amount: Amount to smooth. Zero equals no smoothing, one equals complete smoothing.

        Returns:
            true on success, false on failure.
        """

    def CenterPoint(self) -> Point3d:
        """Compute the center point of the polyline as the weighted average of all segments.

        Returns:
            The weighted average of all segments.
        """

    @staticmethod
    def CreateInscribedPolygon(circle: Circle, sideCount: int) -> Polyline:
        """Create a regular polygon inscribed in a circle. The vertices of the polygon will be on the circle.

        Args:
            circle: The circle.
            sideCount: The number of sides

        Returns:
            A closed polyline if successful, null otherwise.
        """

    @staticmethod
    def CreateCircumscribedPolygon(circle: Circle, sideCount: int) -> Polyline:
        """Create a regular polygon circumscribe about a circle. The midpoints of the polygon's edges will be tangent to the circle.

        Args:
            circle: The circle.
            sideCount: The number of sides

        Returns:
            A closed polyline if successful, null otherwise.
        """

    @staticmethod
    def CreateStarPolygon(circle: Circle, radius: float, cornerCount: int) -> Polyline:
        """Create a regular star polygon. The star begins at circle.PointAt(0) and the vertices alternate between being on circle and begin on a concentric circle of other_radius.

        Args:
            circle: The circle.
            radius: The radius of other circle.
            cornerCount: The number of corners on the circle. There will be 2*cornerCount sides and 2*cornerCount vertices.

        Returns:
            A closed polyline if successful, null otherwise.
        """

    def Duplicate(self) -> Polyline:
        """Returns a deep copy of this polyline instance.

        Returns:
            The duplicated polyline.
        """

class CommonObject:
    """Base class for .NET classes that wrap C++ unmanaged Rhino classes."""

    def Encode(self) -> dict[str, Any]:
        """This object as a JSON-compatible dict (rhino3dm only; inverse: `Decode`).

        Returns:
            A dict of numbers and strings: geometry and other objects are stored as their 3dm archive, base64 encoded, with the archive version.
        """

    @staticmethod
    def Decode(jsonObject: dict[str, Any]) -> CommonObject:
        """The object a dict from `Encode` describes (rhino3dm only).

        Args:
            jsonObject: A dict as `Encode` returns it.
        """

    def RdkXml(self) -> str:
        """The object's render data (RDK) as XML (rhino3dm only).

        Returns:
            The XML text, empty when the object has none.
        """

    @staticmethod
    def ComputeMemoryEstimate(obj: CommonObject) -> int:
        """Computes an estimate of the number of bytes that this object is using in memory.

        This is the same as calling GeometryBase.MemoryEstimate, but works for all CommonObject derived classes.

        Returns:
            An estimated memory footprint.
        """

    @property
    def IsValid(self) -> bool:
        """Tests an object to see if it is valid."""

    def IsValidWithLog(self) -> tuple[bool, str]:
        """Determines if an object is valid. Also provides a report on errors if this object happens not to be valid.

        Returns:
            true if this object is valid; false otherwise.
        """

    @property
    def HasUserData(self) -> bool:
        """Gets true if this class has any custom information attached to it through UserData."""

class GeometryBase(CommonObject):
    """Provides a common base for most geometric classes. This class is abstract."""

    def ComponentIndex(self) -> _rh.ComponentIndex:
        """If this piece of geometry is a component in something larger, like a BrepEdge in a Brep, then this function returns the component index.

        Returns:
            This object's component index. If this object is not a sub-piece of a larger geometric entity, then the returned index has m_type = ComponentIndex.InvalidType and m_index = -1.
        """

    def DataCRC(self, currentRemainder: int) -> int:
        """Returns a CRC calculated from the information that defines the object. This CRC can be used as a quick way to see if two objects are not identical.

        Args:
            currentRemainder: The current remainder value.

        Returns:
            CRC of the information the defines the object.
        """

    def DeleteAllUserStrings(self) -> None:
        ...

    def Duplicate(self) -> GeometryBase:
        """Constructs a deep (full) copy of this object.

        Returns:
            An object of the same type as this, with the same properties and behavior.
        """

    @overload
    def GetBoundingBox(self, xform: _rh.Transform) -> BoundingBox:
        """Aligned Bounding box solver. Gets the world axis aligned bounding box for the transformed geometry.

        Args:
            xform: Transformation to apply to object prior to the BoundingBox computation. The geometry itself is not modified.

        Returns:
            The accurate bounding box of the transformed geometry in world coordinates or BoundingBox.Empty if not bounding box could be found.
        """

    @overload
    def GetBoundingBox(self, plane: Plane) -> BoundingBox:
        """Aligned Bounding box solver. Gets the plane aligned bounding box.

        Args:
            plane: Orientation plane for BoundingBox.

        Returns:
            A BoundingBox in plane coordinates.
        """

    @overload
    def GetBoundingBox(self, accurate: bool) -> BoundingBox:
        """Bounding box solver. Gets the world axis aligned bounding box for the geometry.

        Args:
            accurate: If true, a physically accurate bounding box will be computed. If not, a bounding box estimate will be computed. For some geometry types there is no difference between the estimate and the accurate bounding box. Estimated bounding boxes can be computed much (much) faster than accurate (or "tight") bounding boxes. Estimated bounding boxes are always similar to or larger than accurate bounding boxes.

        Returns:
            The bounding box of the geometry in world coordinates or BoundingBox.Empty if not bounding box could be found.
        """

    def GetUserString(self, key: str) -> str:
        """Gets user string from this geometry.

        Args:
            key: id used to retrieve the string.

        Returns:
            string associated with the key if successful. null if no key was found.
        """

    @property
    def HasBrepForm(self) -> bool:
        """Returns true if the Brep.TryConvertBrep function will be successful for this object"""

    @property
    def IsDeformable(self) -> bool:
        """true if object can be accurately modified with "squishy" transformations like projections, shears, and non-uniform scaling."""

    def MakeDeformable(self) -> bool:
        """If possible, converts the object into a form that can be accurately modified with "squishy" transformations like projections, shears, an non-uniform scaling.

        Returns:
            false if object cannot be converted to a deformable object. true if object was already deformable or was converted into a deformable object.
        """

    def MemoryEstimate(self) -> int:
        """Computes an estimate of the number of bytes that this object is using in memory.

        Returns:
            An estimated memory footprint.
        """

    @property
    def ObjectType(self) -> _rh.ObjectType:
        """Useful for switch statements that need to differentiate between basic object types like points, curves, surfaces, and so on."""

    def Rotate(self, angleRadians: float, rotationAxis: Vector3d, rotationCenter: Point3d) -> bool:
        """Rotates the object about the specified axis. A positive rotation angle results in a counter-clockwise rotation about the axis (right hand rule).

        Args:
            angleRadians: Angle of rotation in radians.
            rotationAxis: Direction of the axis of rotation.
            rotationCenter: Point on the axis of rotation.

        Returns:
            true if geometry successfully rotated.
        """

    def Scale(self, scaleFactor: float) -> bool:
        """Scales the object by the specified factor. The scale is centered at the origin.

        Args:
            scaleFactor: The uniform scaling factor.

        Returns:
            true if geometry successfully scaled.
        """

    def SetUserString(self, key: str, value: str) -> bool:
        """Attach a user string (key,value combination) to this geometry.

        Args:
            key: id used to retrieve this string.
            value: string associated with key.

        Returns:
            true on success.
        """

    def Transform(self, xform: _rh.Transform) -> bool:
        """Transforms the geometry. If the input Transform has a SimilarityType of OrientationReversing, you may want to consider flipping the transformed geometry after calling this function when it makes sense. For example, you may want to call Flip() on a Brep after transforming it.

        Args:
            xform: Transformation to apply to geometry.

        Returns:
            true if geometry successfully transformed.
        """

    @overload
    def Translate(self, translationVector: Vector3d) -> bool:
        """Translates the object along the specified vector.

        Args:
            translationVector: A moving vector.

        Returns:
            true if geometry successfully translated.
        """

    @overload
    def Translate(self, x: float, y: float, z: float) -> bool:
        """Translates the object along the specified vector.

        Args:
            x: The X component.
            y: The Y component.
            z: The Z component.

        Returns:
            true if geometry successfully translated.
        """

    @property
    def UserStringCount(self) -> int:
        """Gets the amount of user strings."""

    def GetUserStrings(self) -> list[Any]:
        """Gets a copy of all (user key string, user value string) pairs attached to this geometry.

        Returns:
            A new collection.
        """

class ModelComponent(CommonObject):
    """Base class for all components in a model (document) and manages the index, id and other information common to this type of objects.

    This class parallels the C++ ON_ModelComponent.
    """

    def ClearId(self) -> None:
        """Resets the HasId property of the model component to false, if possible.

        Raises:
            InvalidOperationException: If the ID is locked.
        """

    def ClearIndex(self) -> None:
        """Resets the HasIndex property of the model component to false, if possible.

        Raises:
            InvalidOperationException: If the index is locked.
        """

    def ClearName(self) -> None:
        """Resets the HasName property of the model component to false, if possible.

        Raises:
            InvalidOperationException: If the name is locked.
        """

    def DataCRC(self, currentRemainder: int) -> int:
        """Increments the Cyclic Redundancy Check value by this instance.

        Args:
            currentRemainder: The current remainder value.

        Returns:
            The updated remainder value.
        """

    @property
    def DeletedName(self) -> str:
        """Gets the name of a component that is deleted."""

    @property
    def HasId(self) -> bool:
        """Returns a value indicating whether the component has an ID."""

    @property
    def HasIndex(self) -> bool:
        """Returns a value indicating whether the component has an Index."""

    @property
    def HasName(self) -> bool:
        """Returns a value indicating whether the component has a Name."""

    @property
    def Id(self) -> uuid.UUID:
        """Gets or sets the ID of the current instance.

        Raises:
            InvalidOperationException: When setting the ID failed. This usually happened because the instance ID is already locked.
        """

    @property
    def IdIsLocked(self) -> bool:
        """Returns a value indicating whether the component ID is already locked."""

    @property
    def Index(self) -> int:
        """Gets or sets the model component index attribute.

        Raises:
            InvalidOperationException: When setting the Index failed. This usually happens because the instance Index is already locked.
        """

    @Index.setter
    def Index(self, arg: int, /) -> None:
        ...

    @property
    def IndexIsLocked(self) -> bool:
        """Returns a value indicating whether the component Index is already locked."""

    @property
    def InstanceDefinitionModelSerialNumber(self) -> int:
        """When a component is in a model as part of the information required for a linked instance definition, this value identifies the linked instance definition reference model.

        Reference components are not saved in .3dm archives. Typically this value is set and locked by the code that adds a component to a model. This value is not saved in .3dm archives.
        """

    @property
    def IsComponentStatusLocked(self) -> bool:
        """The component status itself can be locked. This returns an indication."""

    @property
    def IsDeleted(self) -> bool:
        """true if the component is deleted. Deleted components are kept by the document for undo purposes."""

    @property
    def IsReference(self) -> bool:
        """Gets a value indicting whether this component is a referenced component. Referenced components are part of referenced documents."""

    @property
    def IsSystemComponent(self) -> bool:
        """True if this model component is a system constant.

        An incomplete list of system constant model components is below:

        - ON_ModelComponent::Unset - ON_InstanceDefinition::Empty - ON_Linetype::Unset - ON_Linetype::Continuous - ON_Linetype::ByLayer - ON_Linetype::ByParent - ON_Layer::Unset - ON_Layer::Default - ON_TextStyle::Unset - ON_TextStyle::Default - ON_TextStyle::ByLayer - ON_TextStyle::ByParent - ON_DimStyle::Unset - ON_DimStyle::Default - ON_DimStyle::DefaultInchDecimal - ON_DimStyle::DefaultInchFractional - ON_DimStyle::DefaultFootInchArchitecture - ON_DimStyle::DefaultMillimeterSmall - ON_DimStyle::DefaultMillimeterLarge - ON_DimStyle::DefaultMillimeterArchitecture
        """

    @staticmethod
    def IsValidComponentName(name: str) -> bool:
        """Tests for a valid model component name.

        Args:
            name: The string to validate.

        Returns:
            true if the string is a valid model component name, false otherwise.
        """

    def LockId(self) -> None:
        """Locks the component Id property."""

    def LockIndex(self) -> None:
        """Locks the component Index property."""

    def LockName(self) -> None:
        """Locks the component Name property."""

    @staticmethod
    def ModelComponentTypeIgnoresCase(type: ModelComponentType) -> bool:
        """Informs the developer if a particular model component type will require case-ignoring searching within a document. This is currently true with groups; false otherwise.

        Args:
            type: True if the component ignores case.
        """

    @staticmethod
    def ModelComponentTypeIncludesParent(type: ModelComponentType) -> bool:
        """Informs the developer if a particular model component type will include the hash of the parent.

        Args:
            type: True if the component includes parent hash.
        """

    @staticmethod
    def ModelComponentTypeRequiresUniqueName(type: ModelComponentType) -> bool:
        """Informs the developer if a particular model component type will require uniqueness within a document. This is currently true with render materials and model geometry; false otherwise.

        Args:
            type: The type to check.

        Returns:
            true with render materials and model geometry; false otherwise.
        """

    @property
    def ModelSerialNumber(self) -> int:
        """A value identifying the model that manages this component.

        If the component is being managed by a model, this value identifies the model. In Rhino, this value is the document runtime serial number. Typically this value is set and locked by the code that adds a component to a model. This value is not saved in .3dm archives.
        """

    @property
    def Name(self) -> str:
        """Gets or sets the name

        Raises:
            InvalidOperationException: When setting the Name failed. This usually happens because the instance Name is already locked.
        """

    @Name.setter
    def Name(self, arg: str, /) -> None:
        ...

    @property
    def NameIsLocked(self) -> bool:
        """Returns a value indicating whether the component Name is already locked."""

    @property
    def ReferenceModelSerialNumber(self) -> int:
        """When a component is in a model for reference, this value identifies the reference model.

        Reference components are not saved in .3dm archives. Typically this value is set and locked by the code that adds a component to a model. This value is not saved in .3dm archives.
        """
    NamePathSeparator: str = ...
    """(arg: object, /) -> str"""

class Curve(GeometryBase):
