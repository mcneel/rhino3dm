class TextureMapping(ModelComponent):
    """Represents a texture mapping."""

    @property
    def Capped(self) -> bool:
        """// The m_bCapped applies to planar, cylinder and box mappings. If m_bCapped is false, the cylinder or box is "infinite", if m_bCapped is true, they are finite. In planar mappings, m_bCapped=false means "the Z texture coordinate will always be 0.0" this is now the default behaviour in Rhino 5.0 - it's what users expect apparently."""

    @Capped.setter
    def Capped(self, arg: bool, /) -> None:
        ...

    @staticmethod
    def CreateBoxMapping(plane: Plane, dx: Interval, dy: Interval, dz: Interval, capped: bool) -> TextureMapping:
        """Create a box projection texture mapping.

        When m_texture_space = divided, the box is mapped to texture space as follows: If the box is not capped, then each side maps to 1/4 of the texture map. v=1+---------+---------+---------+---------+ | x=dx[1] | y=dy[1] | x=dx[0] | y=dy[0] | | Front | Right | Back | Left | | --y-> | <-x-- | <-y-- | --x-> | v=0+---------+---------+---------+---------+ 0/4 <=u<= 1/4 <=u<= 2/4 <=u<= 3/4 <=u<= 4/4 If the box is capped, then each side and cap gets 1/6 of the texture map. v=1+---------+---------+---------+---------+---------+---------+ | x=dx[1] | y=dy[1] | x=dx[0] | y=dy[0] | z=dx[1] | z=dz[0] | | Front | Right | Back | Left | Top | Bottom | | --y-> | <x-- | <-y-- | --x-> | --x-> | --x-> | v=0+---------+---------+---------+---------+---------+---------+ 0/6 <=u<= 1/6 <=u<= 2/6 <=u<= 3/6 <=u<= 4/6 <=u<= 5/6 <=u<= 6/6

        Args:
            plane: The sides of the box the box are parallel to the plane's coordinate planes. The dx, dy, dz intervals determine the location of the sides.
            dx: Determines the location of the front and back planes. The vector plane.xaxis is perpendicular to these planes and they pass through plane.PointAt(dx[0],0,0) and plane.PointAt(dx[1],0,0), respectively.
            dy: Determines the location of the left and right planes. The vector plane.yaxis is perpendicular to these planes and they pass through plane.PointAt(0,dy[0],0) and plane.PointAt(0,dy[1],0), respectively.
            dz: Determines the location of the top and bottom planes. The vector plane.zaxis is perpendicular to these planes and they pass through plane.PointAt(0,0,dz[0]) and plane.PointAt(0,0,dz[1]), respectively.
            capped: If true, the box is treated as a finite capped box.

        Returns:
            TextureMapping instance if input is valid
        """

    @staticmethod
    def CreateCustomMeshMapping(mesh: Mesh) -> TextureMapping:
        """Create custom mesh mapping

        Args:
            mesh: Mesh with texture coordinates

        Returns:
            TextureMapping instance
        """

    @staticmethod
    def CreateCylinderMapping(cylinder: Cylinder, capped: bool) -> TextureMapping:
        """Create a cylindrical projection texture mapping.

        When the cylinder is capped and m_texture_space = divided, the cylinder is mapped to texture space as follows: The side is mapped to 0 <= "u" <= 2/3. The bottom is mapped to 2/3 <= "u" <= 5/6. The top is mapped to 5/6 <= "u" <= 5/6. This is the same convention box mapping uses.

        Args:
            cylinder: cylinder in world space used to define a cylindrical coordinate system. The angular parameter maps (0,2pi) to texture "u" (0,1), The height parameter maps (height[0],height[1]) to texture "v" (0,1), and the radial parameter maps (0,r) to texture "w" (0,1).
            capped: If true, the cylinder is treated as a finite capped cylinder

        Returns:
            TextureMapping instance if input is valid
        """

    @staticmethod
    def CreateOcsMapping(plane: Plane) -> TextureMapping:
        """Create a Ocs texture mapping. Note that OCS mappings must be placed on mapping channel ON_ObjectRenderingAttributes::OCSMappingChannelId() otherwise they will not work.

        Args:
            plane: A plane to use for mapping.
        """

    @overload
    @staticmethod
    def CreatePlaneMapping(plane: Plane, dx: Interval, dy: Interval, dz: Interval, capped: bool) -> TextureMapping:
        """Create a planar projection texture mapping

        Args:
            plane: A plane to use for mapping.
            dx: portion of the plane's x axis that is mapped to [0,1] (can be a decreasing interval)
            dy: portion of the plane's y axis that is mapped to [0,1] (can be a decreasing interval)
            dz: portion of the plane's z axis that is mapped to [0,1] (can be a decreasing interval)
            capped: set to true if planar UVW is meant, false for planar UV

        Returns:
            TextureMapping instance if input is valid
        """

    @overload
    @staticmethod
    def CreatePlaneMapping(plane: Plane, dx: Interval, dy: Interval, dz: Interval) -> TextureMapping:
        """Create a planar UV projection texture mapping

        Args:
            plane: A plane to use for mapping.
            dx: portion of the plane's x axis that is mapped to [0,1] (can be a decreasing interval)
            dy: portion of the plane's y axis that is mapped to [0,1] (can be a decreasing interval)
            dz: portion of the plane's z axis that is mapped to [0,1] (can be a decreasing interval)

        Returns:
            TextureMapping instance if input is valid
        """

    @staticmethod
    def CreateSphereMapping(sphere: Sphere) -> TextureMapping:
        """Create a spherical projection texture mapping.

        Args:
            sphere: sphere in world space used to define a spherical coordinate system. The longitude parameter maps (0,2pi) to texture "u" (0,1). The latitude parameter maps (-pi/2,+pi/2) to texture "v" (0,1). The radial parameter maps (0,r) to texture "w" (0,1).

        Returns:
            TextureMapping instance if input is valid
        """

    @staticmethod
    def CreateSurfaceParameterMapping() -> TextureMapping:
        """Create a mapping that will convert surface parameters into normalized(0,1)x(0,1) texture coordinates.

        Returns:
            TextureMapping instance or null if failed.
        """

    @overload
    def Evaluate(self, p: Point3d, n: Vector3d) -> tuple[int, Point3d]:
        """Evaluate the mapping to get a texture coordinate

        Args:
            p: Vertex location
            n: If the mapping projection is ray_projection, then this is the vertex unit normal. Otherwise n is ignored.

        Returns:
            Nonzero if evaluation is successful. When the mapping is a box or capped cylinder mapping, the value indicates which side was evaluated. Cylinder mapping: 1 = cylinder wall, 2 = bottom cap, 3 = top cap Box mapping: 1 = front, 2 = right, 3 = back, 4 = left, 5 = bottom, 6 = top
        """

    @overload
    def Evaluate(self, p: Point3d, n: Vector3d, pXform: Transform, nXform: Transform) -> tuple[int, Point3d]:
        """Evaluate the mapping to get a texture coordinate

        Args:
            p: Vertex location
            n: If the mapping projection is ray_projection, then this is the vertex unit normal. Otherwise n is ignored.
            pXform: Transformation to be applied to P before performing the mapping calculation.
            nXform: Transformation to be applied to N before performing the mapping calculation. One way to calculate nXxform is to use the call pXform::GetVectorTransform(nXform).

        Returns:
            Nonzero if evaluation is successful. When the mapping is a box or capped cylinder mapping, the value indicates which side was evaluated. Cylinder mapping: 1 = cylinder wall, 2 = bottom cap, 3 = top cap Box mapping: 1 = front, 2 = right, 3 = back, 4 = left, 5 = bottom, 6 = top
        """

